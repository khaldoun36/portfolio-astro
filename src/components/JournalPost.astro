---
interface Props {
  href: string;
  title: string;
  description: string;
  datePublished?: Date;
  tag: string;
}

const {
  href,
  title,
  description,
  datePublished = new Date(),
  tag,
} = Astro.props;

// Format dates for the attribute and display
const datetimeAttr = datePublished.toISOString().split("T")[0];
const displayDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(datePublished);
---

<article
  class="py-section group relative justify-between gap-8 lg:grid lg:grid-cols-[20rem_1fr]"
>
  <div class="max-w-prose self-start">
    <h1
      class="mb-6 text-xl font-semibold group-hover:underline sm:text-2xl lg:text-3xl"
    >
      <a href={href} class="after:absolute after:inset-0 after:z-10">
        {title}
      </a>
    </h1>

    <p class="sm:text-md mb-8 text-sm lg:mb-0">
      {description}
    </p>
  </div>

  <aside class="relative space-y-5 *:block lg:col-start-1 lg:row-start-1">
    <time datetime={datetimeAttr} class="sm:text-md text-sm">{displayDate}</time
    >
    <p class="sm:text-md text-sm">
      Tags: <strong>{tag}</strong>
    </p>
  </aside>
</article>

<style>
  @media (width >= 64rem) {
    aside::after {
      content: "";
      position: absolute;
      width: 1px;
      height: calc(100% + (var(--spacing-section) * 2));
      right: 0;
      top: calc(-1 * var(--spacing-section));
      background-color: var(--color-deep-brown);
    }
  }
</style>
