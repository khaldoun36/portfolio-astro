---
import { twMerge } from "tailwind-merge";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={twMerge("py-5 relative", className)}>
  <h2 class="text-2xl font-semibold sm:text-3xl lg:text-4xl">Latest entries</h2>
</div>

<style>
  div::after,
  div::before {
    content: "";
    position: absolute;
    height: 1px;
    background-color: var(--color-deep-brown);

    width: calc(100% + (var(--sheet-padding) * 2));
    left: calc(var(--sheet-padding) * -1);
  }

  div::after {
    top: 0;
  }

  div::before {
    bottom: 0;
  }
</style>
