---
import { Font } from "astro:assets";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
    <Font cssVariable="--font-mona" />
  </head>
  <body>
    <div class="content-grid">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  /* Reference your main tailwind entry point */
  @import "../styles/global.css" reference;

  .content-grid {
    --sheet-padding: 1rem;
    --grid-cols: 0rem var(--sheet-padding) minmax(0, 1fr) var(--sheet-padding)
      0rem;

    position: relative;
    isolation: isolate;

    display: grid;
    grid-template-columns: var(--grid-cols);

    background: var(--color-almond);
  }

  /* Sheet layer */
  .content-grid::before {
    content: "";
    position: absolute;
    z-index: 0;
    pointer-events: none;

    /* Spans across the padding and content columns (lines 2 through 5) */
    grid-column: 2 / 5;
    inset: 0;

    background: var(--color-ivory);

    @apply ds-border;
  }

  .content-grid > * {
    /* Places standard content exclusively in the center column */
    grid-column: 3 / 4;
    min-width: 0;

    position: relative;
    z-index: 1;
  }

  /* Optional utility if you want elements to break out to the padding edges */
  .content-grid > .sheet-width {
    grid-column: 2 / 5;
  }

  .content-grid > .full-width {
    /* Spans all 5 columns */
    grid-column: 1 / -1;
  }

  @media (width >= 40rem) {
    .content-grid {
      --sheet-padding: 2rem;
      --grid-cols: 2rem var(--sheet-padding) minmax(0, 1fr) var(--sheet-padding)
        2rem;
    }
  }

  @media (width >= 80rem) {
    .content-grid {
      --sheet-padding: 3rem;
      --grid-cols: minmax(0, 1fr) var(--sheet-padding) minmax(0, 1216px)
        var(--sheet-padding) minmax(0, 1fr);
    }
  }
</style>
